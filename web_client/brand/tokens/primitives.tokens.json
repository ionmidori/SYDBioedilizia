{
  "$description": "SYD Bioedilizia brand primitives (W3C DTCG). The ONLY place where brand colour values are written. Brand hues were measured on the flat interiors of the master logo (brand/source/syd-logo-source.jpg).",
  "color": {
    "$type": "color",
    "brand": {
      "navy": {
        "900": {
          "$value": "#07385f",
          "$description": "Deepest leaf facet, D stem foot, 'BIO' of the wordmark"
        }
      },
      "steel": {
        "500": {
          "$value": "#35608b",
          "$description": "Lower leaf facet, lightest"
        },
        "700": {
          "$value": "#20517f",
          "$description": "Lower leaf facet"
        }
      },
      "blue": {
        "400": {
          "$value": "#269dc8",
          "$description": "Leaf tip, Y left arm"
        },
        "450": {
          "$value": "#2095c1",
          "$description": "Leaf facet, third stripe"
        },
        "500": {
          "$value": "#1889b8",
          "$description": "Leaf facet, D stem"
        },
        "600": {
          "$value": "#127aac",
          "$description": "Leaf facet, Y stem"
        },
        "700": {
          "$value": "#0c6c9f",
          "$description": "Y right arm, D bowl top, 'EDILIZIA' of the wordmark"
        },
        "800": {
          "$value": "#025b90",
          "$description": "Leaf left facet, D bowl"
        }
      },
      "sand": {
        "500": {
          "$value": "#cda865",
          "$description": "The 'S' shape"
        }
      },
      "white": {
        "$value": "#ffffff"
      }
    },
    "ui": {
      "$description": "Surfaces we do not own but must stay legible on.",
      "browser-tab-dark": {
        "$value": "#35363a",
        "$description": "Active tab in Chrome dark mode: the lightest dark tab surface, so the worst case for the favicon"
      }
    },
    "third-party": {
      "$description": "Colours imposed by third-party brand guidelines (sign-in buttons). Never used as our roles.",
      "google": {
        "surface": {
          "$value": "#ffffff",
          "$description": "Google sign-in button fill (light)"
        },
        "surface-hover": {
          "$value": "#f8fafc",
          "$description": "Google sign-in button hover"
        },
        "ink": {
          "$value": "#1f1f1f",
          "$description": "Google sign-in label"
        },
        "line": {
          "$value": "#747775",
          "$description": "Google sign-in outline"
        },
        "logo-blue": {
          "$value": "#4285f4",
          "$description": "Google G mark, blue segment (brand guidelines)"
        },
        "logo-green": {
          "$value": "#34a853",
          "$description": "Google G mark, green segment"
        },
        "logo-yellow": {
          "$value": "#fbbc05",
          "$description": "Google G mark, yellow segment"
        },
        "logo-red": {
          "$value": "#ea4335",
          "$description": "Google G mark, red segment"
        }
      }
    }
  },
  "palette": {
    "$description": "Tonal ramps generated in OKLCH by scripts/brand/lib/ramp.mjs from the declarations below (anchor = a measured brand colour, or a hue for status colours). Primitives only: never utilities; the site reaches them through the semantic roles.",
    "$type": "color",
    "$extensions": {
      "syd.rampScale": {
        "50": 0.975,
        "100": 0.95,
        "200": 0.9,
        "300": 0.83,
        "400": 0.74,
        "500": 0.64,
        "600": 0.55,
        "700": 0.47,
        "800": 0.39,
        "900": 0.31,
        "950": 0.24
      }
    },
    "neutral": {
      "$description": "Calm limestone neutral (desaturated for architectural clarity)",
      "$extensions": {
        "syd.ramp": {
          "hueFrom": "{color.brand.sand.500}",
          "chroma": 0.003
        }
      }
    },
    "blue": {
      "$extensions": {
        "syd.ramp": {
          "anchor": "{color.brand.blue.700}",
          "chroma": 0.14
        }
      }
    },
    "sand": {
      "$extensions": {
        "syd.ramp": {
          "anchor": "{color.brand.sand.500}",
          "chroma": 0.12
        }
      }
    },
    "red": {
      "$extensions": {
        "syd.ramp": {
          "hue": 25,
          "chroma": 0.17
        }
      }
    },
    "amber": {
      "$extensions": {
        "syd.ramp": {
          "hue": 75,
          "chroma": 0.15
        }
      }
    },
    "green": {
      "$extensions": {
        "syd.ramp": {
          "hue": 150,
          "chroma": 0.13
        }
      }
    }
  }
}
