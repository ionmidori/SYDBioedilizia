rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SESSIONS COLLECTION
    // ==========================================
    // Auth-required read with ownership check. No age limit: the user's chat is
    // permanent (Phase 139); guest chats expire through the expireAt TTL.
    // Server-only write (only Admin SDK can create/update)
    match /sessions/{sessionId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Only server can write (via Admin SDK with service account)
      allow write: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read only if the user owns the parent session. No more
        // global-<uid> / guest-<uid> ids without a parent: the chat id comes from
        // the backend (Phase 139), and its session always exists.
        // SECURITY (F-03): require the parent session to EXIST and be owned.
        // A "!exists(...) ||" fallback would grant read to ANY authenticated user
        // whenever the parent session doc was missing (phantom-parent).
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/sessions/$(sessionId))
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;

        // Only server can write messages
        allow write: if false;
      }
    }

    // ==========================================
    // LEADS COLLECTION
    // ==========================================
    // Server-only access (sensitive customer data)
    match /leads/{leadId} {
      // Only server can read/write leads
      allow read, write: if false;
    }


    // ==========================================
    // USER PREFERENCES
    // ==========================================

    match /users/{userId}/preferences/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // PASSKEYS SUBCOLLECTION
    // ==========================================
    // Server-only write (registered via backend API)
    // Owner-only read (for credential discovery)

    match /users/{userId}/passkeys/{credId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ==========================================
    // PROJECT FILES METADATA
    // ==========================================

    match /projects/{projectId}/files/{fileId} {
      // Read: user must own the project.
      // SECURITY (F-03): require the parent project to EXIST and be owned — the
      // previous "!exists(...) ||" fallback leaked file metadata of any missing
      // project to any authenticated user.
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;

      // Write: user must own the project AND NOT BE ANONYMOUS.
      // SECURITY (F-03): require existence so metadata cannot be injected into a
      // not-yet-created project by a non-owner.
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;

      // Delete: user must own the project AND be the uploader
      allow delete: if request.auth != null
        && resource.data.uploadedBy == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // ==========================================
    // PROJECT ROOMS (Phase 138)
    // ==========================================
    // One chat per home: each room ("scheda stanza") of the project. The owner
    // reads them (room chips, onSnapshot); only the backend writes (Admin SDK),
    // through /api/projects/{id}/rooms and the agent tools.
    match /projects/{projectId}/rooms/{roomId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;

      allow write: if false;
    }

    // ==========================================
    // COLLECTION GROUP: FILES
    // ==========================================
    // Global Gallery queries restricted to files the user uploaded.
    // READ-ONLY: Firestore grants access if ANY matching rule allows it, so a
    // permissive write here would override the project-ownership check in
    // /projects/{projectId}/files (letting a user inject metadata into another
    // user's project). All writes go through the Admin SDK, which bypasses
    // these rules, so client writes are denied here.
    match /{path=**}/files/{fileId} {
      allow read: if request.auth != null
        && resource.data.uploadedBy == request.auth.uid;

      allow write, delete: if false;
    }

    // ==========================================
    // PROJECTS COLLECTION
    // ==========================================

    match /projects/{projectId} {
      // Read: owner-only (Strict Deep Claim)
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Writes go through the backend only (Admin SDK bypasses rules): a client
      // write skipped the 5-project limit and could set any field, e.g. status
      // (security audit 2026-10-03, L6). The web client never writes here.
      allow write: if false;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================

    // Users can only read/write their own data
    match /users/{userId} {
      // Allow authenticated users to read their own data
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to write their own data + schema validation.
      // SECURITY (F-10): block privilege/claim fields from being self-assigned
      // in the user document. Authorization is enforced via Firebase custom
      // claims (server-side), never from this doc, so these keys are never
      // legitimately client-writable — denying them prevents confusion and any
      // UI that might (incorrectly) trust a doc-level role.
      // The user's chat (Phase 139) is decided by the backend: the client can
      // neither set nor change the pointer, but keeps writing its other fields.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.size() <= 30
        && !request.resource.data.keys().hasAny(['role', 'roles', 'admin', 'isAdmin', 'claims', 'customClaims', 'permissions'])
        && !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['chat_id', 'chat_assigned_at'])
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200))
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string);
    }

    // ==========================================
    // TESTIMONIALS COLLECTION
    // ==========================================
    match /testimonials/{testimonialId} {
      // Backend only (/api/content/testimonials, Admin SDK). A public read
      // exposed the author's userId, i.e. valid uids to target (security audit
      // 2026-10-03, M3); the web client neither reads nor writes here.
      allow read, write: if false;
    }

    // ==========================================
    // PORTFOLIO PROJECTS COLLECTION
    // ==========================================
    // Public read — displayed on landing page (active items only filtered client-side)
    // Write admin-only via Admin SDK (bypasses rules)
    match /portfolio_projects/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // DEFAULT RULE - DENY ALL
    // ==========================================
    // Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

