# Exclude local virtual environments
.venv/
venv/
.python-version

# Exclude python cache
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Exclude test files and cache
tests/
tests_manual/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
repro_issues.py
test_*.py
verify_*.py

# Exclude debug and maintenance scripts in root
debug_*.py
debug_*.txt
fix_*.py
list_*.py
process_*.py
punch_*.py
diecut_*.py
fade_*.py
flood_*.py
magic_*.py
saturation_*.py
targeted_*.py
scripts/
*.ps1
*.sh
!entrypoint.sh

# Exclude offline ingestion data (prezzario PDFs/JSON read only by scripts/).
# Runtime data lives in src/data/, which stays in the image.
data/

# Exclude documentation and project files
docs/
*.md
.gcloudignore

# Exclude env files and credentials (secrets should be injected at runtime)
.env
.env.*
**/firebase-service-account.json
**/*.pem
**/*.key
**/*.p12

# Exclude git
.git
.gitignore

# Exclude IDE settings
.vscode/
.idea/
