# Firebase Configuration (Required)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Internal JWT Secret (Required)
INTERNAL_JWT_SECRET=your-secret-key-here

# Environment: "development" or "production" (default: production / fail-secure)
ENV=production
# DEV ONLY — skips Firebase token verification. Requires ENV=development.
# Startup will FAIL if this is True while ENV != development.
ALLOW_AUTH_BYPASS=false

# Google Gemini API (Required)
GOOGLE_API_KEY=your-gemini-api-key

# Perplexity API (Optional - for market prices)
PERPLEXITY_API_KEY=your-perplexity-key

# Model Armor LLM guardrails (OWASP LLM01/LLM02). Enabled by default but inert
# until a template is configured. Set the template ID (from GCP console) to
# activate input/output filtering in production.
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_TEMPLATE_ID=
MODEL_ARMOR_LOCATION=europe-west1

# ── Gemini model registry (src/core/models.py) ──────────────────────────────
# Model IDs live ONLY in settings: code resolves them by role. Unset roles
# fall back to CHAT_MODEL_VERSION. Pin GA IDs, never `*-latest` aliases.
CHAT_MODEL_VERSION=gemini-3.5-flash-lite
# MODEL_ROUTER=
# MODEL_TRIAGE=
# MODEL_DESIGN=
# MODEL_QUOTE=
# MODEL_VISION=gemini-3.8-flash   # only for the customer's uploaded photos/videos
# MODEL_INSIGHT=
# MODEL_IMAGE=gemini-3.1-flash-image-preview
# Thinking level per role: minimal | low | medium | high (unset = model default)
# THINKING_LEVEL_ROUTER=
# THINKING_LEVEL_QUOTE=
# Per-call limits for chat agents (unset = SDK defaults: no timeout, no retry)
# LLM_TIMEOUT_SECONDS=
# LLM_RETRY_ATTEMPTS=
# LLM_MAX_OUTPUT_TOKENS=
# Gemini on Vertex AI instead of AI Studio (ADC credentials, no API key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=eu   # EU multi-region; europe-west1 does not serve Gemini 3.x
# MODEL_IMAGE=gemini-3.1-flash-image   # the only image model on Vertex `eu`
# Refuse to go live (startup probe 503) if a configured model is not served
# MODEL_VALIDATION_STRICT=false
