# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright auth state: contains a live emulator ID token. The blanket *.json
# rule below already covers user.json, but this is explicit (and covers uid.txt).
web_client/e2e/**/.auth/
**/playwright-report-authed/

# playwright (e2e artifacts)
**/playwright-report/
**/test-results/
**/.playwright/
/web_client/playwright/.cache/

# next.js
**/.next/
# Separate build artifact for the authenticated E2E suite (NEXT_DIST_DIR)
**/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# server logs and debug files
server*.log
*.log
*.log.*
*.bak

# env files (can opt-in for committing if needed)
.env*
env.local.template

# vercel
.vercel

# generated renders
/public/renders/

# eval results (live runs output, not committed)
backend_python/tests/evals/results/

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
**/firebase-service-account.json

# Secrets & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.json
!package.json
!package-lock.json
!backend_python/pyrightconfig.json
# Runtime data read by backend_python/src (price book seed, assemblies,
# aggregation rules). Must be versioned: a build from a clean checkout would
# otherwise ship without it (guarded by tests/unit/test_build_context.py).
!backend_python/src/data/*.json
!tsconfig.json
!jsconfig.json
!vercel.json
!firestore.indexes.json
# Firebase CLI config: declares the rules/indexes files AND the emulator ports
# used by the authenticated E2E suite. Without it tracked, `firebase
# emulators:exec` has nothing to read on a fresh CI checkout.
!firebase.json
# Blog characterization fixtures (recorded article output, no secrets) — required
# by web_client/lib/blog/__tests__/blog-characterization.test.tsx in CI
!web_client/lib/blog/__fixtures__/*.json
# Contracts shared by backend and frontend tests (generated test data, no secrets),
# e.g. contracts/money/golden_vectors.json — required by pytest and jest in CI
!contracts/**/*.json
# ADK eval fixtures (test data, no secrets) — required by tests/evals/test_eval_infrastructure.py in CI
!backend_python/tests/evals/*.test.json
!backend_python/tests/evals/test_config.json
!.eslintrc.json
!tailwind.config.json
!package-root.json
!manifest.json

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# admin tool secrets
# The Streamlit admin tool was removed (Phase 128, Fase 7). A local copy of its folder may still hold
# credentials (config.yaml, service-account key): keep them out of git until deleted by hand.
admin_tool/config.yaml

# project memory & directives — LOCAL ONLY, must NOT be pushed to GitHub
directives/
docs/
gemini.md
CLAUDE.md
# generated and re-added by `next dev` (Next.js 16.3+)
AGENTS.md
SECURITY_AUDIT_P*.md
architecture_analysis.md
backend_python/docs/chain_of_thought_analysis.md
backend_python/server_debug.log

# temporary files
nul
output.txt
commit_files.txt
.git_status.txt


# n8n and Supabase were decommissioned (Phase 129). A local copy of their folders
# may still hold real secrets (n8n/.env.n8n) or project state: keep them out of
# git until deleted by hand.
/n8n/
/n8n_workflows/
/supabase/

# backend runtime data artifacts (extraction logs, scraped HTML, raw PDFs)
backend_python/data/*.txt
backend_python/data/*.html
backend_python/data/*.pdf
backend_python/data/*.log

# agent skills & tooling (local-only, not needed on GitHub)
.agents/
.gemini/skills/
skills_dev/
skills_pkg/
backend_python/deploy/.vertex-previous-revision
