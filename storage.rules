rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }
    
    function isValidDocument() {
      return request.resource.contentType == 'application/pdf';
    }
    
    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|x-msvideo)');
    }
    
    function isWithinSizeLimit(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }
    
    function isNonAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Project ownership lives in Firestore (projects/{id}.userId; project id ==
    // session id). A missing doc makes .data fail, so the rule denies.
    function ownsProject(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // ==========================================
    // USER AVATARS
    // ==========================================
    
    match /users/{userId}/avatar.webp {
      allow write: if isAuthenticated() 
        && isOwner(userId)
        && isValidImage()
        && isWithinSizeLimit(5);
      
      allow read: if isAuthenticated();
    }
    
    // ==========================================
    // PROJECT FILES (Manual Uploads)
    // ==========================================
    
    match /projects/{projectId}/uploads/{fileName} {
      // SECURITY (audit 2026-10-03, H2): owner only — before this, any registered
      // user with a projectId could read, overwrite and delete these files.
      allow write: if isAuthenticated()
        && isNonAnonymous()
        && ownsProject(projectId)
        && (
          (isValidImage() && isWithinSizeLimit(10)) ||
          (isValidDocument() && isWithinSizeLimit(25)) ||
          (isValidVideo() && isWithinSizeLimit(100))
        );

      allow read, delete: if isAuthenticated() && isNonAnonymous() && ownsProject(projectId);
    }
    
    // ==========================================
    // RENDERS FOLDER (AI-Generated Images)
    // ==========================================
    
    match /renders/{sessionId}/{fileName} {
      // SECURITY (audit 2026-10-03, H2): owner only. The old renders/{allPaths=**}
      // read let any registered user list renders/ and harvest every session id.
      // The app itself serves renders through backend signed URLs.
      allow read: if isAuthenticated() && isNonAnonymous() && ownsProject(sessionId);
      allow write: if false;
    }
    
    // ==========================================
    // USER UPLOADS FOLDER (Chat Attachments)
    // ==========================================
    
    match /user-uploads/{sessionId}/{fileName} {
      // SECURITY: owner only (same IDOR as renders/, audit 2026-10-03)
      allow read: if isAuthenticated() && isNonAnonymous() && ownsProject(sessionId);
      allow write: if false;
    }
    
    // ==========================================
    // DEFAULT RULE - DENY ALL
    // ==========================================

    // Deny access to all other folders
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
